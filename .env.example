# Required Shopline API settings.
SHOPLINE_API_BASE_URL=https://jp-sosove.myshopline.com
SHOPLINE_ACCESS_TOKEN=your-shopline-api-token
SHOPLINE_ORDERS_ENDPOINT=/orders
SHOPLINE_PRODUCTS_ENDPOINT=/products

# API normalization and request settings.
SHOPLINE_API_VERSION=v20260301
SHOPLINE_STORE_DOMAIN=jp-sosove.myshopline.com
# Comma-separated storefront domains used to remove self-referrals.
SHOPLINE_STOREFRONT_DOMAINS=sosove.com
SHOPLINE_TOKEN_HEADER=Authorization
SHOPLINE_AUTH_PREFIX=Bearer
SHOPLINE_DEFAULT_CURRENCY=JPY
SHOPLINE_TIMEZONE=Asia/Tokyo
SHOPLINE_MAX_ORDER_PAGES=10
SHOPLINE_ORDER_CHUNK_DAYS=7
SHOPLINE_TIMEOUT_SECONDS=12
DASHBOARD_CACHE_SECONDS=120

# Conversion rate settings.
# The dashboard calculates conversion as orders / visitors by default.
# Fill daily traffic from Shopline analytics, GA4, or another traffic source.
SHOPLINE_CONVERSION_TRAFFIC_FIELD=visitors
SHOPLINE_TRAFFIC_JSON={}
# Example:
# SHOPLINE_TRAFFIC_JSON={"2026-06-17":{"visitors":1200,"sessions":1350}}

# GA4 conversion settings.
# Use GA4 Data API to read userKeyEventRate:purchase as the conversion rate.
GA4_PROPERTY_ID=
GA4_KEY_EVENT_NAME=purchase
GA4_CONVERSION_METRIC=userKeyEventRate
GA4_CONVERSION_MODE=key_event_rate
GA4_SERVICE_ACCOUNT_FILE=
GA4_SERVICE_ACCOUNT_JSON=
GA4_TIMEOUT_SECONDS=30

# Profit estimate settings.
SHOPLINE_PRODUCT_COST_RATE=0.35
SHOPLINE_PAYMENT_FEE_RATE=0.036
SHOPLINE_SHIPPING_COST_PER_ORDER=500
# Exact SKU unit costs override the default product cost rate.
SHOPLINE_SKU_COST_JSON={}
# Example: {"SKU-001":1200,"SKU-002":980}
SHOPLINE_SHIPPING_COST_BY_MARKET_JSON={"JP":500}

# Optional alert thresholds.
DASHBOARD_ALERT_THRESHOLDS_JSON={"orderDropPercent":30,"lowStock":5,"hotStock":10,"hotSalesUnits":5,"unpaidCount":5,"unpaidRate":20,"refundCount":2,"refundRate":3,"minimumRoas":1.5,"minimumConversion":1}
DASHBOARD_ALERT_WEBHOOK_URL=
DASHBOARD_ALERT_WEBHOOK_ON_SYNC=false

# Optional dashboard access control. Leave token empty for open local access.
DASHBOARD_ACCESS_TOKEN=
DASHBOARD_ROLE=admin

# Ad spend settings. Individual channel values override SHOPLINE_AD_SPEND_JSON.
SHOPLINE_AD_SPEND_JSON={"Facebook":0,"Instagram":0,"Google":0,"TikTok":0,"Email":0,"Direct":0,"Organic":0,"Ad":0}
SHOPLINE_AD_SPEND_FACEBOOK=0
SHOPLINE_AD_SPEND_INSTAGRAM=0
SHOPLINE_AD_SPEND_GOOGLE=0
SHOPLINE_AD_SPEND_TIKTOK=0
SHOPLINE_AD_SPEND_EMAIL=0
SHOPLINE_AD_SPEND_DIRECT=0
SHOPLINE_AD_SPEND_ORGANIC=0
SHOPLINE_AD_SPEND_AD=0
